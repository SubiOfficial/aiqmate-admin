generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// TENANTS (existing, extended with billing fields)
// ===========================================================================

model Tenant {
  id               String    @id @default(uuid())
  orgId            String    @unique @map("org_id")
  orgCode          String?   @map("org_code")
  name             String
  industry         String?
  country          String?
  state            String?
  city             String?
  address          String?
  postalCode       String?   @map("postal_code")
  website          String?
  seatLimit        Int       @default(0) @map("seat_limit")
  seatsUsed        Int       @default(0) @map("seats_used")
  activeUsers30d   Int       @default(0) @map("active_users_30d")
  lastActivityAt   DateTime? @map("last_activity_at")
  health           String    @default("OK")
  billingTimezone  String    @default("UTC") @map("billing_timezone")
  paymentTermsDays Int       @default(30) @map("payment_terms_days")
  status           String    @default("ACTIVE") @map("tenant_status")
  activatedAt      DateTime? @map("activated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  contacts        Contact[]
  hierarchyLevels TenantAssetHierarchyLevel[]
  assets          Asset[]
  payments        Payment[]
  subscription    Subscription?
  memberships     TenantMembership[]
  pricingConfigs  TenantProcedurePricing[]
  executions      ProcedureExecution[]
  invoices        Invoice[]
  auditLogs       AuditLog[]

  @@map("tenants")
}

// ===========================================================================
// CONTACTS (existing, unchanged)
// ===========================================================================

model Contact {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  email       String
  phone       String?
  role        String
  designation String?
  contactType String   @default("GENERAL") @map("contact_type")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

// ===========================================================================
// ASSET HIERARCHY LEVELS (existing, unchanged)
// ===========================================================================

model TenantAssetHierarchyLevel {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  levelKey              String   @map("level_key")
  displayName           String   @map("display_name")
  pluralName            String   @map("plural_name")
  levelOrder            Int      @map("level_order")
  isEnabled             Boolean  @default(true) @map("is_enabled")
  isRootLevel           Boolean  @default(false) @map("is_root_level")
  allowMultipleChildren Boolean  @default(true) @map("allow_multiple_children")
  icon                  String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@unique([tenantId, levelKey])
  @@unique([tenantId, levelOrder])
  @@map("tenant_asset_hierarchy_levels")
}

// ===========================================================================
// ASSETS (existing, unchanged)
// ===========================================================================

model Asset {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  parentAssetId    String?   @map("parent_asset_id")
  hierarchyLevelId String    @map("hierarchy_level_id")
  assetCode        String    @map("asset_code")
  defaultName      String    @map("default_name")
  displayName      String?   @map("display_name")
  status           String    @default("ACTIVE")
  criticality      String    @default("STANDARD")
  location         String?
  assetClass       String?   @map("asset_class")
  assetModel       String?   @map("asset_model")
  modelTemplateId  String?   @map("model_template_id")
  metadata         Json?     @db.JsonB
  isActive         Boolean   @default(true) @map("is_active")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hierarchyLevel TenantAssetHierarchyLevel @relation(fields: [hierarchyLevelId], references: [id])
  parent         Asset?                    @relation("AssetTree", fields: [parentAssetId], references: [id])
  children       Asset[]                   @relation("AssetTree")

  @@unique([tenantId, assetCode])
  @@index([tenantId])
  @@index([parentAssetId])
  @@index([hierarchyLevelId])
  @@map("assets")
}

// ===========================================================================
// USERS, ROLES, PERMISSIONS, MEMBERSHIPS (new — spec section 5)
// ===========================================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  memberships TenantMembership[]
  executions  ProcedureExecution[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  displayName String   @map("display_name")
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  memberships TenantMembership[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  displayName String   @map("display_name")
  group       String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

// ===========================================================================
// PROCEDURE CATEGORIES & EXECUTION TRACKING (new — spec sections 7, 8)
// ===========================================================================

model ProcedureCategory {
  id          String   @id @default(uuid())
  key         String   @unique
  displayName String   @map("display_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  executions     ProcedureExecution[]
  pricingConfigs TenantProcedurePricing[]

  @@map("procedure_categories")
}

model ProcedureExecution {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  userId          String    @map("user_id")
  categoryId      String    @map("category_id")
  procedureRef    String?   @map("procedure_ref")
  idempotencyKey  String    @unique @map("idempotency_key")
  status          String    @default("PENDING")
  isBillable      Boolean   @default(false) @map("is_billable")
  billingPeriod   String?   @map("billing_period")
  pricingConfigId String?   @map("pricing_config_id")
  pricingSnapshot Json?     @map("pricing_snapshot") @db.JsonB
  quantity        Int       @default(1)
  currency        String?
  amount          Decimal?  @db.Decimal(18, 6)
  invoiceItemId   String?   @map("invoice_item_id")
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  failedAt        DateTime? @map("failed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id])
  category ProcedureCategory @relation(fields: [categoryId], references: [id])

  @@index([tenantId, billingPeriod])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
  @@map("procedure_executions")
}

// ===========================================================================
// TENANT-SPECIFIC PRICING (new — spec section 7)
// NUMERIC(18,6) for all rates. Never Float.
// ===========================================================================

model TenantProcedurePricing {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  categoryId    String?   @map("category_id")
  pricingScope  String    @default("ALL") @map("pricing_scope")
  pricingModel  String    @map("pricing_model")
  billingPeriod String    @map("billing_period")
  currency      String    @default("USD")
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  status        String    @default("DRAFT")
  version       Int       @default(1)
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ProcedureCategory? @relation(fields: [categoryId], references: [id])
  tiers    TenantProcedurePricingTier[]

  @@index([tenantId, status])
  @@index([tenantId, categoryId, status])
  @@map("tenant_procedure_pricing")
}

model TenantProcedurePricingTier {
  id              String  @id @default(uuid())
  pricingConfigId String  @map("pricing_config_id")
  minimumQuantity Int     @map("minimum_quantity")
  maximumQuantity Int?    @map("maximum_quantity")
  unitRate        Decimal @map("unit_rate") @db.Decimal(18, 6)
  tierOrder       Int     @map("tier_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  pricingConfig TenantProcedurePricing @relation(fields: [pricingConfigId], references: [id], onDelete: Cascade)

  @@unique([pricingConfigId, tierOrder])
  @@map("tenant_procedure_pricing_tiers")
}

// ===========================================================================
// INVOICES & LINE ITEMS (new — spec section 10)
// Separate from payments. NUMERIC(18,6) for all amounts.
// ===========================================================================

model Invoice {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  invoiceNumber      String    @unique @map("invoice_number")
  billingPeriodStart DateTime  @map("billing_period_start")
  billingPeriodEnd   DateTime  @map("billing_period_end")
  currency           String    @default("USD")
  subtotal           Decimal   @default(0) @map("subtotal") @db.Decimal(18, 6)
  taxRate            Decimal?  @map("tax_rate") @db.Decimal(5, 4)
  taxAmount          Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 6)
  discountAmount     Decimal   @default(0) @map("discount_amount") @db.Decimal(18, 6)
  adjustmentAmount   Decimal   @default(0) @map("adjustment_amount") @db.Decimal(18, 6)
  total              Decimal   @default(0) @db.Decimal(18, 6)
  amountPaid         Decimal   @default(0) @map("amount_paid") @db.Decimal(18, 6)
  outstandingBalance Decimal   @default(0) @map("outstanding_balance") @db.Decimal(18, 6)
  status             String    @default("DRAFT")
  dueDate            DateTime  @map("due_date")
  paidAt             DateTime? @map("paid_at")
  voidedAt           DateTime? @map("voided_at")
  notes              String?
  createdBy          String?   @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([tenantId, billingPeriodStart, billingPeriodEnd])
  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceItem {
  id              String  @id @default(uuid())
  invoiceId       String  @map("invoice_id")
  categoryId      String? @map("category_id")
  description     String
  pricingModel    String  @map("pricing_model")
  pricingConfigId String? @map("pricing_config_id")
  pricingSnapshot Json?   @map("pricing_snapshot") @db.JsonB
  quantity        Int
  unitRate        Decimal @map("unit_rate") @db.Decimal(18, 6)
  amount          Decimal @db.Decimal(18, 6)
  tierMin         Int?    @map("tier_min")
  tierMax         Int?    @map("tier_max")
  tierOrder       Int     @default(0) @map("tier_order")
  createdAt       DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ===========================================================================
// PAYMENTS (existing, modified: Float->Decimal, added invoice FK)
// ===========================================================================

model Payment {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  invoiceId          String?   @map("invoice_id")
  invoiceNumber      String?   @map("invoice_number")
  amount             Decimal   @db.Decimal(18, 6)
  currency           String    @default("USD")
  status             String    @default("PENDING")
  paymentMethod      String?   @map("payment_method")
  providerPaymentId  String?   @unique @map("provider_payment_id")
  providerEventId    String?   @unique @map("provider_event_id")
  billingPeriodStart DateTime? @map("billing_period_start")
  billingPeriodEnd   DateTime? @map("billing_period_end")
  dueDate            DateTime? @map("due_date")
  paidAt             DateTime? @map("paid_at")
  failedAt           DateTime? @map("failed_at")
  refundedAmount     Decimal   @default(0) @map("refunded_amount") @db.Decimal(18, 6)
  description        String?
  transactionId      String?   @map("transaction_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

// ===========================================================================
// SUBSCRIPTIONS (existing, modified: Float->Decimal, added lifecycle fields)
// ===========================================================================

model Subscription {
  id                   String    @id @default(uuid())
  tenantId             String    @unique @map("tenant_id")
  plan                 String
  status               String    @default("TRIAL")
  subscriptionModel    String    @default("USAGE_BASED") @map("subscription_model")
  startDate            DateTime  @map("start_date")
  endDate              DateTime? @map("end_date")
  trialEndsAt          DateTime? @map("trial_ends_at")
  renewalDate          DateTime? @map("renewal_date")
  billingCycle         String    @default("MONTHLY") @map("billing_cycle")
  monthlyRate          Decimal   @map("monthly_rate") @db.Decimal(18, 6)
  includedAllowance    Int?      @map("included_allowance")
  currency             String    @default("USD")
  autoRenew            Boolean   @default(true) @map("auto_renew")
  cancelledAt          DateTime? @map("cancelled_at")
  cancellationReason   String?   @map("cancellation_reason")
  previousPlan         String?   @map("previous_plan")
  previousMonthlyRate  Decimal?  @map("previous_monthly_rate") @db.Decimal(18, 6)
  planChangedAt        DateTime? @map("plan_changed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ===========================================================================
// AUDIT LOG (new — spec section 19)
// ===========================================================================

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  reason     String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_log")
}
